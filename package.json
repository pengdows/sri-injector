{
  "name": "@pengdows/sri-injector",
  "version": "1.0.0",
  "description": "Inject Subresource Integrity (integrity + crossorigin) into built HTML: CLI plus Vite, Rollup and webpack plugins.",
  "keywords": [
    "sri",
    "subresource-integrity",
    "integrity",
    "security",
    "vite",
    "rollup",
    "webpack",
    "csp"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/pengdows/sri-injector.git"
  },
  "license": "MIT",
  "author": "Pengdows LLC",
  "main": "index.js",
  "bin": {
    "sri-injector": "bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./rollup": {
      "types": "./adapters/rollup.d.ts",
      "default": "./adapters/rollup.js"
    },
    "./vite": {
      "types": "./adapters/vite.d.ts",
      "default": "./adapters/vite.js"
    },
    "./webpack": {
      "types": "./adapters/webpack.d.ts",
      "default": "./adapters/webpack.js"
    },
    "./core": {
      "types": "./core.d.ts",
      "default": "./core.js"
    },
    "./external": "./external.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "core.js",
    "core.d.ts",
    "types.d.ts",
    "external.js",
    "HashAlgo.js",
    "SubresourceIntegrityInjector.js",
    "bin/",
    "adapters/",
    "lib/"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "jest",
    "run": "node ./bin/cli.js",
    "coverage": "jest --coverage && c8 jest --runInBand __tests__/cli.test.js",
    "test:browser": "jest --testPathIgnorePatterns /node_modules/ /__tests__/helpers/ /__tests__/types/ --runInBand __tests__/browser"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "parse5": "^7.3.0"
  },
  "peerDependencies": {
    "rollup": ">=3",
    "vite": ">=4",
    "webpack": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-html": "^2.0.0",
    "@rspack/core": "^2.3.2",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-legacy": "^8.2.4",
    "@web/rollup-plugin-html": "^4.0.1",
    "c8": "^12.0.0",
    "fs-extra": "^11.4.1",
    "html-rspack-plugin": "^6.1.11",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.5.2",
    "playwright-core": "^1.65.0",
    "rolldown": "^1.3.2",
    "rollup": "^4.68.2",
    "semver": "^7.8.6",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "webpack": "^5.112.2"
  },
  "jest": {
    "transform": {},
    "coverageProvider": "v8",
    "collectCoverageFrom": [
      "*.js",
      "adapters/**/*.js",
      "lib/**/*.js",
      "!jest.config.js"
    ],
    "coverageReporters": [
      "text"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 98,
        "statements": 98,
        "functions": 98,
        "branches": 90
      }
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/helpers/",
      "/__tests__/types/",
      "/__tests__/browser/"
    ]
  },
  "types": "./index.d.ts"
}
